# Copy this file outside the repository with mode 600. Never commit populated values.
DB_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://pos.example.com
TLS_CERT_DIR=/etc/tb-terminal/tls
STORE_NAME=
STORE_ADDRESS=
STORE_PHONE=

# Only for the first production startup; remove after the owner can sign in.
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_PIN=

LOG_LEVEL=WARN
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=10000
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_UPLOAD_MB=1024
RESTORE_ENABLED=false

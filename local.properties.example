APP_ENV=development
DB_URL=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=tb-terminal
JWT_AUDIENCE=tb-terminal-client
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
MANAGER_APPROVAL_TTL_MINUTES=5
# Umur maksimum sesi kas offline saat di-sync, 1-168 jam.
OFFLINE_MAX_SESSION_AGE_HOURS=72
# Simpan di volume privat di luar checkout source. Jangan commit dump.
BACKUP_ENABLED=false
BACKUP_DIRECTORY=D:/private/tb-terminal-backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_UPLOAD_MB=1024
PG_DUMP_EXECUTABLE=pg_dump
PG_RESTORE_EXECUTABLE=pg_restore
# Aktifkan hanya selama maintenance restore yang diawasi.
RESTORE_ENABLED=false
# Foto produk Cloudinary (ubah PRODUCT_PHOTO_ENABLED=true setelah kredensial diisi).
PRODUCT_PHOTO_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=tbterminal/products
CLOUDINARY_MAX_IMAGE_BYTES=5242880
